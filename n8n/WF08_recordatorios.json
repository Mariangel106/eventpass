    {
      "id": "49032b02-c9f8-4e23-aa80-040405b4292f",
      "name": "Fila: Registrar recordatorio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        180
      ],
      "parameters": {
        "jsCode": "const COLS = [\"recordatorio_id\",\"usuario_id\",\"evento_id\",\"inscripcion_id\",\"tipo_recordatorio\",\"fecha_programada\",\"fecha_envio\",\"estado\",\"clave_idempotencia\"];\nconst pick = (o) => Object.fromEntries(COLS.map((c) => [c, o?.[c] ?? '']));\nconst data = (() => {\n  const res = $input.all();\n  return $('Detectar recordatorios pendientes').all().map((it, idx) => {\n    const r = res[idx]?.json || {};\n    const enviado = r.gmail_estado === 'ENVIADO' || r.telegram_estado === 'ENVIADO';\n    const estado = r.omitido ? 'OMITIDO' : enviado ? 'ENVIADO' : 'ERROR';\n    return { ...it.json.recordatorio, estado, fecha_envio: enviado ? new Date().toISOString() : '' };\n  });\n})();\nreturn (Array.isArray(data) ? data : [data]).map((r) => ({ json: pick(r) }));\n"
      }
    },
