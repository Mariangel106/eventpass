    {
      "id": "df72d595-af71-4352-b2c9-6d29c0204b0b",
      "name": "Resultado Gmail",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        0
      ],
      "parameters": {
        "jsCode": "const p = $('Preparar notificación').first().json;\nconst r = $input.first().json;\nconst msg = (e) => (typeof e === 'string' ? e : e?.message || JSON.stringify(e));\nif (!p.email) return [{ json: { gmail_estado: 'NO_APLICA', gmail_error: 'Usuario sin correo' } }];\nreturn [{ json: r.error ? { gmail_estado: 'ERROR', gmail_error: msg(r.error) } : { gmail_estado: 'ENVIADO', gmail_error: '' } }];\n"
      }
    },
