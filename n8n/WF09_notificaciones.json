    {
      "id": "d0dc7fa0-ee82-476f-ad49-8f840963936b",
      "name": "Fila: Registrar notificación",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        0
      ],
      "parameters": {
        "jsCode": "const COLS = [\"notificacion_id\",\"usuario_id\",\"tipo\",\"titulo\",\"mensaje\",\"evento_id\",\"inscripcion_id\",\"fecha\",\"gmail_estado\",\"telegram_estado\",\"gmail_error\",\"telegram_error\",\"clave_idempotencia\"];\nconst pick = (o) => Object.fromEntries(COLS.map((c) => [c, o?.[c] ?? '']));\nconst data = (() => {\n  const p = $('Preparar notificación').first().json;\n  const g = $('Resultado Gmail').first().json;\n  const t = $('Resultado Telegram').first().json;\n  return { notificacion_id: `NOT-${Date.now().toString(36).toUpperCase()}${Math.random().toString(36).slice(2, 6).toUpperCase()}`,\n    usuario_id: p.usuario_id, tipo: p.tipo, titulo: p.titulo, mensaje: p.mensaje, evento_id: p.evento_id,\n    inscripcion_id: p.inscripcion_id, fecha: new Date().toISOString(), gmail_estado: g.gmail_estado,\n    telegram_estado: t.telegram_estado, gmail_error: g.gmail_error, telegram_error: t.telegram_error, clave_idempotencia: p.clave };\n})();\nreturn (Array.isArray(data) ? data : [data]).map((r) => ({ json: pick(r) }));\n"
      }
    },
