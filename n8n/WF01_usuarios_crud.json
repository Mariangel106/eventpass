    {
      "id": "f7cc7bef-add1-4ff6-a0a2-ba9cfb41c190",
      "name": "Generar hash, salt y usuario_id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        0
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst d = $input.first().json;\nconst ahora = new Date().toISOString();\n// PBKDF2-SHA256 con salt aleatorio de 16 bytes y 100.000 iteraciones\nconst salt = crypto.randomBytes(16).toString('hex');\nconst hash = crypto.pbkdf2Sync(d.password, salt, 100000, 32, 'sha256').toString('hex');\nconst usuario_id = `USR-${Date.now().toString(36).toUpperCase()}${crypto.randomBytes(2).toString('hex').toUpperCase()}`;\nreturn [{ json: {\n  usuario_id, nombre: d.nombre, email_normalizado: d.email, password_hash: hash, password_salt: salt,\n  estado: 'ACTIVO', fecha_registro: ahora, fecha_actualizacion: ahora,\n  telefono: d.telefono, ciudad: d.ciudad, organizacion: d.organizacion, notif_email: 'SI', notif_telegram: 'SI'\n} }];\n"
      }
    },
