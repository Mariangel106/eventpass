# EventPass - Variables de entorno del frontend (Vite)
# Copia este archivo como .env y completa los valores. NUNCA subas el .env al repositorio.

# URL base de los webhooks de producción de n8n (sin "/" al final).
# Ejemplo n8n Cloud:      https://tu-usuario.app.n8n.cloud/webhook
# Ejemplo self-hosted:    https://n8n.tudominio.com/webhook
# Si se deja vacía, la web funciona en "Modo Demostración" con datos locales.
VITE_N8N_BASE_URL=""

# URL del Chat Trigger del WF10 (EventPass Assistant). Se copia del nodo "Chat Trigger":
# termina en /chat, por ejemplo https://tu-usuario.app.n8n.cloud/webhook/<id-del-webhook>/chat
VITE_N8N_CHAT_URL=""

# Usuario del bot de Telegram creado con @BotFather (sin la @)
VITE_TELEGRAM_BOT_USERNAME="EventPassNotificaBot"
